<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>tr</string>
	<key>CFBundleDisplayName</key>
	<string>SimBridge</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>simbridge</string>
				<string>tel</string>
				<string>telprompt</string>
			</array>
		</dict>
	</array>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>SimBridge</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsArbitraryLoads</key>
		<true/>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<key>NSBonjourServices</key>
	<array>
		<string>_simbridge._tcp</string>
	</array>
	<key>NSCameraUsageDescription</key>
	<string>Android cihazdaki QR eşleştirme kodunu taramak için kamera erişimi gereklidir.</string>
	<key>NSContactsUsageDescription</key>
	<string>Arayan ve SMS gönderen kişilerin adlarını göstermek için rehber erişimi gereklidir.</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>SimBridge, iPhone ekranı kilitliyken Redmi köprü bağlantısının kesilmemesi ve aramaların/SMS'lerin anında düşmesi için GPS çipini açmadan düşük güçlü (3 km hücresel/Wi-Fi) arka plan konum servisini kullanır.</string>
	<key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
	<string>SimBridge'in arka planda uyutulmaması ve üst ekranda mavi konum çubuğu çıkmadan yerel ağ (LAN) köprüsünü 7/24 açık tutabilmesi için lütfen "Her Zaman" (Always) seçeneğini seçin.</string>
	<key>NSLocationAlwaysUsageDescription</key>
	<string>SimBridge'in arka planda uyutulmaması ve üst ekranda mavi konum çubuğu çıkmadan yerel ağ (LAN) köprüsünü 7/24 açık tutabilmesi için "Her Zaman" izni gereklidir.</string>
	<key>NSLocalNetworkUsageDescription</key>
	<string>Hotspot ve yerel Wi-Fi üzerinden Android cihazla arama sesi ve SMS aktarımı yapmak için yerel ağ erişimi gereklidir.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>Telefon görüşmelerinde sesinizi karşı tarafa aktarmak için mikrofon erişimi gereklidir.</string>
	<key>NSUserActivityTypes</key>
	<array>
		<string>INStartCallIntent</string>
		<string>INStartAudioCallIntent</string>
	</array>
	<key>BGTaskSchedulerPermittedIdentifiers</key>
	<array>
		<string>com.simbridge.ios.refresh</string>
		<string>com.sait.dist.refresh</string>
	</array>
	<key>UIBackgroundModes</key>
	<array>
		<string>voip</string>
		<string>audio</string>
		<string>location</string>
		<string>fetch</string>
		<string>remote-notification</string>
		<string>processing</string>
	</array>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
	</dict>
	<key>UILaunchScreen</key>
	<dict/>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
</dict>
</plist>
